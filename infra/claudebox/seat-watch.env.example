# Copy to ~/.config/kulturni-prehled/seat-watch.env (chmod 600).
#
# The token needs season:read + season:write — the watcher reads the open
# watches and reports each pass back. Mint it with scripts/mint-pat.sh.
KP_API_BASE=https://kulturniprehled.example.com
KP_TOKEN=

# Where the hit lands. Falls back to DIGEST_MAIL_TO when unset, so a box that
# already sends the weekly digest needs nothing here.
SEAT_WATCH_MAIL_TO=
SMTP_HOST=
SMTP_PORT=587
SMTP_STARTTLS=1
SMTP_USER=
SMTP_PASSWORD=
DIGEST_MAIL_FROM=
