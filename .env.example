# Copy to .env and fill in real values. .env is gitignored.

# Postgres
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=kp
POSTGRES_USER=kp
POSTGRES_PASSWORD=changeme

# MinIO
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=kp-minio
MINIO_SECRET_KEY=changeme-changeme
MINIO_BUCKET_TICKETS=tickets
MINIO_REGION=eu-central-1
MINIO_USE_SSL=false
# Public endpoint baked into presigned URLs. Leave blank in dev so it
# falls back to MINIO_ENDPOINT. In production set to the
# Cloudflare-tunnel-fronted host, e.g. tickets.kp.example.com.
MINIO_PUBLIC_ENDPOINT=
MINIO_PUBLIC_USE_SSL=
MINIO_PRESIGNED_URL_TTL_SECONDS=900

# Host port mappings (override if the default ports are taken on your machine)
POSTGRES_HOST_PORT=15432
MINIO_HOST_PORT=19000
MINIO_CONSOLE_HOST_PORT=19001
API_HOST_PORT=18000

# API
API_HOST=0.0.0.0
API_PORT=8000
API_JWT_SECRET=replace-with-long-random-string
API_JWT_ACCESS_TTL_SECONDS=900
API_JWT_REFRESH_TTL_SECONDS=2592000

# Google OAuth — create a Web application OAuth client in your own Google Cloud
# project (Console → APIs & Services → Credentials). See docs/SELF-HOSTING.md.
# CLIENT_ID is the audience that mobile ID tokens are verified against.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_CALENDAR_ID=

# Allowed user emails (comma separated). Whitelist of the workspace.
ALLOWED_EMAILS=petr@example.com

# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# Error reporting (Sentry / self-hosted GlitchTip). Leave blank in dev.
SENTRY_DSN=
SENTRY_ENVIRONMENT=dev
SENTRY_TRACES_SAMPLE_RATE=0

# Logging
LOG_LEVEL=INFO
